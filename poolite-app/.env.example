# Copy to .env and fill in once you've created the projects below.
# See supabase/README.md for step-by-step setup instructions.

# --- Supabase (Project Settings → API) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Stripe (Dashboard → Developers → API keys, TEST mode) ---
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Electricity price used for the cost estimate (see README) ---
EXPO_PUBLIC_ELECTRICITY_RATE=0.28
